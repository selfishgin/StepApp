<Window x:Class="StepAppAdmin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:StepAppAdmin"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <DockPanel>
            <StackPanel DockPanel.Dock="Left" Width="200" Background="#FF2D2D30">
                <Button Content="Products" Name="ProductsButton" Click="Products_Click" Margin="10" Foreground="White" Background="#FF007ACC"/>
                <Button Content="Orders" Name="OrdersButton" Click="Orders_Click" Margin="10" Foreground="White" Background="#FF007ACC"/>
                <Button Content="Users" Name="UsersButton" Click="Users_Click" Margin="10" Foreground="White" Background="#FF007ACC"/>
                <Button Content="Categories" Name="CategoriesButton" Click="Categories_Click" Margin="10" Foreground="White" Background="#FF007ACC"/>
                <Button Content="Statistics" Name="StatisticsButton" Click="Statistics_Click" Margin="10" Foreground="White" Background="#FF007ACC"/>
                <Button Content="Logout" Name="LogoutButton" Click="Logout_Click" Margin="10" Foreground="White" Background="#FFD83B01"/>
            </StackPanel>
            <Frame Name="MainFrame" NavigationUIVisibility="Hidden" />
        </DockPanel>
    </Grid>
</Window>
