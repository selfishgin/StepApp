<Window x:Class="StepAppAdmin.Views.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Yeni Məhsul Əlavə Et" Height="400" Width="400">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!--<TextBlock Text="Product Name:" VerticalAlignment="Center"/>-->
    <TextBox x:Name="ProductNameTextBox" materialDesign:HintAssist.Hint="Product Name" VerticalAlignment="Center" Grid.Row="0" Margin="0,5,0,5"/>

    <!--<TextBlock Text="Description:" Grid.Row="1" VerticalAlignment="Center"/>-->
    <TextBox x:Name="ProductDescriptionTextBox" materialDesign:HintAssist.Hint="Description" VerticalAlignment="Center" Grid.Row="1" Margin="0,5,0,5"/>

    <!--<TextBlock Text="Price:" Grid.Row="2" VerticalAlignment="Center"/>-->
    <TextBox x:Name="ProductPriceTextBox" materialDesign:HintAssist.Hint="Price" VerticalAlignment="Center" Grid.Row="2" Margin="0,5,0,5"/>

    <!--<TextBlock Text="Stock:" Grid.Row="3" VerticalAlignment="Center"/>-->
    <TextBox x:Name="ProductStockTextBox" materialDesign:HintAssist.Hint="Stock" VerticalAlignment="Center" Grid.Row="3" Margin="0,5,0,5"/>

    <!--<TextBlock Text="Image Path:" Grid.Row="4" VerticalAlignment="Center"/>-->
    <StackPanel Grid.Row="4" Orientation="Horizontal">
      <TextBox x:Name="ProductImagePathTextBox" materialDesign:HintAssist.Hint="Image Path" VerticalAlignment="Center" Width="200" Margin="0,5,10,5"/>
      <Button Content="Browse..." Click="BrowseImage_Click"/>
    </StackPanel>

    <!--<TextBlock Text="Category ID:" Grid.Row="5" VerticalAlignment="Center"/>-->
    <ComboBox x:Name="CategoryComboBox" materialDesign:HintAssist.Hint="Category" VerticalAlignment="Center" Grid.Row="5" Margin="0,5,0,5" DisplayMemberPath="Name" SelectedValuePath="Id"/>

    <Button Content="Add Product" Grid.Row="6" HorizontalAlignment="Right" Width="100" Click="AddProduct_Click"/>
  </Grid>
</Window>
