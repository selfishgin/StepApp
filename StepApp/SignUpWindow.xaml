 <!--materialDesign:HintAssist.Hint-->
<Window x:Class="StepApp.SignUpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="SignUp" Height="450" Width="400">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
        </Grid.RowDefinitions>
        
        <!-- İstifadəçi qeydiyyat üçün girişlər -->
        <TextBox x:Name="txtName" materialDesign:HintAssist.Hint="Name" Grid.Row="1" Width="350"/>
        <TextBox x:Name="txtSurname" materialDesign:HintAssist.Hint="Surname" Grid.Row="2" Width="350"/>
        <DatePicker x:Name="dpDateOfBirth" materialDesign:HintAssist.Hint="Date of Birth" Grid.Row="3" Width="350"/>
        <TextBox x:Name="txtEmail" materialDesign:HintAssist.Hint="Email" Grid.Row="4" Width="350"/>
        <PasswordBox x:Name="pwdPassword" materialDesign:HintAssist.Hint="Password" Grid.Row="5" Width="350"/>
        <TextBox x:Name="pwdPasswordVisible" Visibility="Collapsed"  materialDesign:HintAssist.Hint="Password" Grid.Row="5" Width="350"/>
        <CheckBox Name="chkShowPassword" Content="Show Password" HorizontalAlignment="Right" Margin="10" VerticalAlignment="Top" Checked="chkShowPassword_Checked" Unchecked="chkShowPassword_Unchecked" Grid.Row="6"/>


        <!-- Qeydiyyat və Geri Dönüş düymələri -->
        <Button Content="Sign Up" Click="SignUp_Click" Width="100" HorizontalAlignment="Center" Grid.Row="7"/>
        <Button Content="Back" Click="Back_Click" Width="100" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Row="0"/>
    </Grid>
</Window>
