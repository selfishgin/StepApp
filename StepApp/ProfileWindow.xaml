<Window x:Class="StepApp.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Profile" Height="550" Width="400">
    <Grid>
        <!-- Define Rows -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Profile Content -->
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="LightBlue" Height="50">
            <TextBlock Text="Your Profile" FontSize="20" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Profile Content Section with ScrollViewer -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <Image Name="UserProfileImage" Width="100" Height="100" Margin="10"/>
                <TextBlock Name="UserNameTextBlock" FontSize="16" Margin="10" Text="Name"/>
                <TextBlock Name="UserEmailTextBlock" FontSize="16" Margin="10" Text="Email"/>
                <TextBlock Name="UserPhoneTextBlock" FontSize="16" Margin="10" Text="Phone"/>
                <TextBlock Name="UserAddressTextBlock" FontSize="16" Margin="10" Text="Address"/>
                <!-- Personal Information Section -->
                <TextBlock Text="Personal Information" FontSize="16" FontWeight="Bold" Margin="0,10,0,5"/>
                <TextBox Name="txtName" materialDesign:HintAssist.Hint="Name" Margin="0,5"/>
                <TextBox Name="txtSurname" materialDesign:HintAssist.Hint="Surname" Margin="0,5"/>
                <DatePicker Name="dpDateOfBirth" materialDesign:HintAssist.Hint="Date of Birth" Margin="0,5"/>
                <TextBox Name="txtEmail" materialDesign:HintAssist.Hint="Email" Margin="0,5" IsReadOnly="True"/>
                <Button Content="Save Changes" Click="SaveChanges_Click" Margin="0,10"/>

                <!-- Change Password Section -->
                <TextBlock Text="Change Password" FontSize="16" FontWeight="Bold" Margin="20,20,0,5"/>
                <PasswordBox Name="pwdCurrentPassword" materialDesign:HintAssist.Hint="Current Password" Margin="0,5"/>
                <PasswordBox Name="pwdNewPassword" materialDesign:HintAssist.Hint="New Password" Margin="0,5"/>
                <PasswordBox Name="pwdConfirmPassword" materialDesign:HintAssist.Hint="Confirm New Password" Margin="0,5"/>
                <Button Content="Change Password" Click="ChangePassword_Click" Margin="0,10"/>

                <!-- Order History Section -->
                <TextBlock Text="Order History" FontSize="16" FontWeight="Bold" Margin="20,20,0,5"/>
                <Button Content="View Order History" Click="ViewOrderHistory_Click" Margin="0,10"/>

                <!-- Credit Card Management Section -->
                <TextBlock Text="Credit Card Management" FontSize="16" FontWeight="Bold" Margin="20,20,0,5"/>
                <ComboBox Name="cbCreditCards" materialDesign:HintAssist.Hint="Select Credit Card" Margin="0,5">
                    <!-- Example items; these should be populated dynamically -->
                    <ComboBoxItem Content="Visa ****1234"/>
                    <ComboBoxItem Content="MasterCard ****5678"/>
                </ComboBox>
                <Button Content="Add New Card" Click="AddCard_Click" Margin="0,10"/>
                <Button Content="Delete Card" Click="DeleteCard_Click" Margin="0,10"/>
            

            

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
