<Window x:Class="StepApp.ProductDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"                
        Title="Product Details" Height="450" Width="400">
    <Grid>
        <!-- Məhsul Detalları -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Name="ProductNameTextBlock" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10"/>
            <Image Name="ProductImage" Width="200" Height="200" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Name="ProductPriceTextBlock" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="10"/>
            <TextBlock Name="ProductStockTextBlock" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="10"/>

            <!-- Add to Cart düyməsi -->
            <Button Name="AddToCart" Content="Add to Cart" Click="AddToCart_Click" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="10"/>
        </StackPanel>
    </Grid>
</Window>
