<Window x:Class="StepApp.MainPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Main Page" Height="800" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Background="LightBlue" Height="50">
            <TextBlock Text="StepApp" FontSize="20" VerticalAlignment="Center" Margin="10,0,0,0" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" DockPanel.Dock="Right">
                <Button FontFamily="Segoe MDL2 Assets" FontSize="20" Content="&#xE7BF;" Margin="10,0" Click="Cart_Click"/>
                <Button FontFamily="Segoe MDL2 Assets" FontSize="20" Content="&#xE77B;" Margin="10,0" Click="Profile_Click"/>
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Background="LightGray" Height="35" HorizontalAlignment="Stretch" Margin="0,0,0,0">
            <ComboBox Name="CategoryFilter" Width="150" Margin="10,0,0,0" SelectionChanged="CategoryFilter_SelectionChanged"/>
            <TextBox Name="MinPrice" Width="100" Margin="10,10,0,0" TextAlignment="Center" />
            <TextBox Name="MaxPrice" Width="100" Margin="10,10,0,0" TextAlignment="Center"/>
            <Button Content="Filter" Margin="10,0" Click="Filter_Click"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <UniformGrid Name="ProductGrid" Rows="2" Columns="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,0,0"/>
        </ScrollViewer>
    </Grid>
</Window>
