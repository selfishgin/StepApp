<Window x:Class="StepApp.VerificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Verification" Height="200" Width="400">
    <Grid Margin="10">
        <TextBlock Text="Enter Verification Code" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="16"/>
        <TextBox Name="txtVerificationCode" VerticalAlignment="Top" Margin="0,50,0,0" HorizontalAlignment="Center" Width="200"/>
        <Button Content="Verify" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,100,0,0" Width="100" Click="Verify_Click"/>
    </Grid>
</Window>
