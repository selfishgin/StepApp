<Window x:Class="StepApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Login" Height="300" Width="400">
    <Grid Margin="10">
        <Button Content="Back" Click="Back_Click" Width="75" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBox Name="txtEmail" materialDesign:HintAssist.Hint="Email" VerticalAlignment="Top" Margin="0,60,0,0"/>
        <PasswordBox Name="pwdPassword" VerticalAlignment="Top" Margin="0,110,0,0" materialDesign:HintAssist.Hint="Password"/>
        <TextBox Name="pwdPasswordVisible" VerticalAlignment="Top" Margin="0,110,0,0" Visibility="Collapsed"/>
        <CheckBox Name="chkShowPassword" Content="Show Password" VerticalAlignment="Top" Margin="0,150,0,0" Checked="chkShowPassword_Checked" Unchecked="chkShowPassword_Unchecked"/>
        <Button Content="Log in" VerticalAlignment="Top" Margin="0,190,0,0" Click="Login_Click"/>
    </Grid>
</Window>
